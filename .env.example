# Ключ OMIM REST API (https://omim.org/api). Без него используется NCBI Entrez.
OMIM_API_KEY=

# Необязательно: повышает лимит NCBI E-utilities.
NCBI_API_KEY=
NCBI_EMAIL=

# PostgreSQL knowledge base (optional). If unset, JSON fallback is used.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres

